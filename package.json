{
  "name": "telegram-reference-bot",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --watchAll --detectOpenHandles --forceExit",
    "orm:generate": "prisma generate",
    "orm:push": "prisma db push",
    "orm:migrate": "prisma migrate dev --name init",
    "orm:seed": "ts-node --esm prisma/seed.ts"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "node-telegram-bot-api": "^0.66.0",
    "prisma": "^6.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
